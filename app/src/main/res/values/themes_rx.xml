<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The redesigned app theme: light only, warm background, ink buttons, one orange accent. -->
    <style name="Theme.Rx" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/rx_ink</item>
        <item name="colorPrimaryVariant">@color/rx_ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/rx_accent</item>
        <item name="colorSecondaryVariant">@color/rx_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/rx_surface</item>
        <item name="colorOnSurface">@color/rx_ink</item>
        <item name="android:colorBackground">@color/rx_bg</item>
        <item name="android:windowBackground">@color/rx_bg</item>
        <item name="android:statusBarColor">@color/rx_bg</item>
        <item name="android:navigationBarColor">@color/rx_surface</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:fontFamily">@font/hanken_grotesk</item>
        <item name="fontFamily">@font/hanken_grotesk</item>
        <item name="android:textColorPrimary">@color/rx_ink</item>
        <item name="android:textColorSecondary">@color/rx_muted</item>
        <item name="android:textColorHint">@color/rx_muted</item>
        <item name="textAppearanceButton">@style/TextAppearance.Rx.Button</item>
        <item name="materialButtonStyle">@style/Widget.Rx.Button</item>
    </style>

    <!-- ===== Text ===== -->
    <style name="TextAppearance.Rx.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/hanken_grotesk</item>
        <item name="fontFamily">@font/hanken_grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Rx.Text" parent="">
        <item name="android:textColor">@color/rx_ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Rx.Text.Heading">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Rx.Text.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Rx.Text.Section">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Rx.Text.Stat">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Rx.Text.Muted">
        <item name="android:textColor">@color/rx_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Rx.Text.Label">
        <item name="android:textColor">@color/rx_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Rx.Text.Mono">
        <item name="android:textColor">@color/rx_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>
    <style name="Rx.Text.Link">
        <item name="android:textColor">@color/rx_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Status / priority pill. Colours are set in code (UiUtils.bindStatus) -->
    <style name="Rx.Pill" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== Surfaces ===== -->
    <style name="Rx.Card" parent="">
        <item name="android:background">@drawable/bg_rx_card</item>
    </style>

    <!-- Filter chip: a TextView that is "selected" when active -->
    <style name="Rx.Chip" parent="">
        <item name="android:background">@drawable/bg_rx_chip</item>
        <item name="android:textColor">@color/rx_chip_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Segment option (Low / Medium / High, role picker) inside a RadioGroup -->
    <style name="Rx.Segment" parent="">
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/rx_seg_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Widget.Rx.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/rx_ink</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Rx.Button.Light">
        <item name="backgroundTint">@color/rx_button_light</item>
        <item name="android:textColor">@color/rx_ink</item>
    </style>
    <style name="Widget.Rx.Button.Accent">
        <item name="backgroundTint">@color/rx_accent</item>
    </style>
    <style name="Widget.Rx.Button.Small">
        <item name="android:minHeight">40dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Widget.Rx.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/rx_surface</item>
        <item name="strokeColor">@color/rx_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/rx_ink</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ===== Text fields ===== -->
    <style name="Widget.Rx.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/rx_field_stroke</item>
        <item name="boxBackgroundColor">@color/rx_surface</item>
        <item name="hintTextColor">@color/rx_muted</item>
        <item name="android:textColorHint">@color/rx_muted</item>
    </style>
    <style name="Widget.Rx.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/rx_field_stroke</item>
        <item name="boxBackgroundColor">@color/rx_surface</item>
        <item name="hintTextColor">@color/rx_muted</item>
        <item name="android:textColorHint">@color/rx_muted</item>
    </style>

</resources>
