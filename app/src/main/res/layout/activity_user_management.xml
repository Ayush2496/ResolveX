<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_header_home" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/chipTabStaff"
            style="@style/Rx.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resolvers" />

        <TextView
            android:id="@+id/chipTabStudents"
            style="@style/Rx.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Students" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddStaff"
            style="@style/Widget.Rx.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add staff" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvUserCount"
        style="@style/Rx.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp" />

    <!-- The ScrollView takes all remaining space (so the bottom bar stays visible); the card hugs its content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStaff"
            style="@style/Rx.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:nestedScrollingEnabled="false" />
    </ScrollView>

    <include layout="@layout/view_bottom_bar" />

</LinearLayout>
