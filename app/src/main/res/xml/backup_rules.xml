<?xml version="1.0" encoding="utf-8"?>
<!-- Used on Android 11 and older. Nothing is backed up (see data_extraction_rules.xml for Android 12+). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
